# 2. Large Local Indexes & Cache
eagle_material_index.json
*.info/
*.info
*.cache

# 3. Temp & Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

# 4. OS & IDE junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
